### - testes da API - o REST Client

### - Teste se o servidor está funcionando
GET http://localhost:3000/
Content-Type: application/json

#####################################
### - Teste do gatilho da Carga Inicial em Lote (bulkCreate)

### - Carga de Usuários (API dummyjson.com/users)
POST http://localhost:3000/carga/usuarios
Content-Type: application/json

### - Carga de Produtos (API dummyjson.com/products)
POST http://localhost:3000/carga/produtos
Content-Type: application/json

#####################################
### - Teste CRUD de Usuário

### - Cadastrar o Usuário
POST http://localhost:3000/usuario
Content-Type: application/json

{
    "nome": "Adalberto",
    "sobrenome": "Souza",
    "idade": 32,
    "email": "adalberto@gmail.com",
    "telefone": "(47) 99999-0001",
    "endereco": "Rua das Flores, 100",
    "cidade": "Joinville",
    "estado": "Santa Catarina"
}

### - Listar os Usuários
GET http://localhost:3000/usuarios
Content-Type: application/json

### - Consultar Usuário por código
GET http://localhost:3000/usuario/1
Content-Type: application/json

### - Consultar Usuário por nome
GET http://localhost:3000/usuario/buscar/Adalberto
Content-Type: application/json

### - Atualizar o Usuário
PUT http://localhost:3000/usuario/1
Content-Type: application/json

{
    "nome": "Adalberto",
    "sobrenome": "Souza Filho",
    "idade": 33,
    "email": "adalberto@gmail.com",
    "telefone": "(47) 99999-0002",
    "endereco": "Rua das Flores, 100",
    "cidade": "Joinville",
    "estado": "Santa Catarina"
}

### - Excluir o Usuário
DELETE http://localhost:3000/usuario/1
Content-Type: application/json

#####################################
### - Teste CRUD de Produto

### - Cadastrar o Produto
POST http://localhost:3000/produto
Content-Type: application/json

{
    "nome": "Notebook Gamer",
    "descricao": "Notebook com placa de vídeo dedicada",
    "categoria": "eletronicos",
    "preco": 4999.90,
    "desconto": 5,
    "estoque": 8,
    "marca": "Acer",
    "imagem": "https://exemplo.com/notebook.jpg"
}

### - Listar os Produtos
GET http://localhost:3000/produtos
Content-Type: application/json

### - Consultar Produto por código
GET http://localhost:3000/produto/1
Content-Type: application/json

### - Consultar Produto por nome
GET http://localhost:3000/produto/buscar/Notebook Gamer
Content-Type: application/json

### - Atualizar o Produto
PUT http://localhost:3000/produto/1
Content-Type: application/json

{
    "nome": "Notebook Gamer Pro",
    "descricao": "Notebook com placa de vídeo dedicada",
    "categoria": "eletronicos",
    "preco": 5499.90,
    "desconto": 10,
    "estoque": 8,
    "marca": "Acer",
    "imagem": "https://exemplo.com/notebook.jpg"
}

### - Excluir o Produto
DELETE http://localhost:3000/produto/1
Content-Type: application/json

#####################################
### - Teste de Movimentação de Estoque (Compras)

### - Cadastrar compra com SUCESSO (SAIDA com saldo suficiente)
POST http://localhost:3000/compra
Content-Type: application/json

{
    "idUsuario": 1,
    "idProduto": 1,
    "tipoMovimento": "SAIDA",
    "quantidade": 2,
    "desconto": 5,
    "formaPagamento": "CREDITO",
    "status": "PAGA",
    "data": "2026-07-10"
}

### - Cadastrar compra com ERRO (SAIDA sem saldo suficiente)
POST http://localhost:3000/compra
Content-Type: application/json

{
    "idUsuario": 1,
    "idProduto": 1,
    "tipoMovimento": "SAIDA",
    "quantidade": 99999,
    "desconto": 0,
    "formaPagamento": "DINHEIRO",
    "status": "PENDENTE",
    "data": "2026-07-10"
}

### - Cadastrar compra do tipo ENTRADA
POST http://localhost:3000/compra
Content-Type: application/json

{
    "idUsuario": 1,
    "idProduto": 1,
    "tipoMovimento": "ENTRADA",
    "quantidade": 15,
    "desconto": 0,
    "formaPagamento": "DEBITO",
    "status": "PAGA",
    "data": "2026-07-11"
}

### - Listar o histórico de Compras
GET http://localhost:3000/compras
Content-Type: application/json

